---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Paragraphs from '../components/Paragraphs.astro';
import FirstSteps from '../components/FirstSteps.astro';
import RelatedServices from '../components/RelatedServices.astro';
import { getEntry, render } from 'astro:content';

// D4: the $65 rate is gone; the pitch is experience, not price.
// Page kept pending O2 (Eric's call at copy review).
//
// Copy is CMS-editable (pages/veterans); the H1, the section heading, and the
// layout stay code-owned. An item links when it names something that has a
// page of its own — a fixed dropdown in the CMS, not free text.
const page = await getEntry('pages', 'veterans');
const { Content: Intro } = await render(page);
const { workOnList = [] } = page.data;
---

<Layout>
	<PageHero heading="Counseling for Veterans" subhead={page.data.heroSubhead} />

	<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 md:py-20">
		<div class="prose-site text-lg">
			<Intro />
		</div>

		{
			/*
			 Conditional for the reason /about's "fun" list is (fa530dd): a list Eric
			 empties in the CMS otherwise ships an <h2> above an empty <ul>, which is
			 a dangling heading and invalid HTML besides.
			*/
		}
		{
			workOnList.length > 0 && (
				<>
					<h2 class="mt-12 text-3xl">What we can work on</h2>
					<ul class="mt-6 space-y-3">
						{workOnList.map((item) => (
							<li class="flex items-start gap-3">
								<span aria-hidden="true" class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-clay-400" />
								<span class="text-lg">
									{item.link ? (
										<a href={item.link} class="link-inline">
											{item.text}
										</a>
									) : (
										item.text
									)}
								</span>
							</li>
						))}
					</ul>
				</>
			)
		}

		<div class="prose-site mt-12 text-lg">
			<Paragraphs text={page.data.closingBody} />
		</div>
	</section>

	<RelatedServices />
	<FirstSteps />
</Layout>
