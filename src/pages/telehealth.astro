---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import FirstSteps from '../components/FirstSteps.astro';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import couplePhoto from '../assets/images/couple-online-session.jpg';

// Prose is CMS-editable (pages/telehealth); headings, layout, the numbered-step
// styling, and the photo stay code-only so Eric cannot break the design.
const page = await getEntry('pages', 'telehealth');
const { Content: Intro } = await render(page);
const { firstSessionSteps = [], checklist = [] } = page.data;
---

<Layout
	title="How Online Therapy Sessions Work | Custom Counseling"
	description={page.data.seoDescription}
>
	<PageHero
		heading="How Online Sessions Work"
		subhead="The same conversation you'd have in an office, from the comfort of home."
	/>

	<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 md:py-20">
		<div class="prose-site text-lg">
			<Intro />
		</div>

		<h2 class="mt-12 text-3xl">What a first session looks like</h2>
		<ol class="mt-6 space-y-4">
			{
				firstSessionSteps.map((step, i) => (
					<li class="flex gap-4">
						<span
							aria-hidden="true"
							class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-clay-400 font-display font-semibold text-ink-950"
						>
							{i + 1}
						</span>
						<p class="pt-1">{step}</p>
					</li>
				))
			}
		</ol>

		<div class="mt-12 grid items-center gap-10 md:grid-cols-2">
			<div>
				<h2 class="text-3xl">What you need</h2>
				<ul class="mt-5 space-y-3">
					{
						checklist.map((item) => (
							<li class="flex items-center gap-3">
								<span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-clay-400" />
								{item}
							</li>
						))
					}
				</ul>
			</div>
			<Image
				src={couplePhoto}
				alt="A couple at home on their couch, meeting with their counselor over a laptop"
				width={800}
				height={533}
				densities={[1, 2]}
				class="w-full rounded-lg shadow-sm"
			/>
		</div>

		<div class="prose-site mt-12 text-lg">
			<h2 class="text-3xl">Couples over video</h2>
			<p>{page.data.couplesBody}</p>

			<h2 class="text-3xl">Is it private?</h2>
			<p>{page.data.privacyBody}</p>

			<h2 class="text-3xl">What if the tech acts up?</h2>
			<p>{page.data.techFailureBody}</p>
		</div>
	</section>

	<FirstSteps />
</Layout>
