---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { Image } from 'astro:assets';
import ericPhoto from '../assets/images/eric-tulga.jpg';
import { getEntry, render } from 'astro:content';

const about = await getEntry('pages', 'about');
const { Content: Bio } = await render(about);

// The "fun" list survives the rebuild on purpose — it's the best trust content
// on the old site (build reference §4). CMS-editable because it dates faster
// than anything else here: pets, teams, and hobbies change.
const { funList = [] } = about.data;
---

<Layout>
	<PageHero heading="Eric Tulga, MA, LPC" subhead="A counselor you can actually talk to." />

	<section class="mx-auto grid max-w-6xl items-start gap-10 px-4 py-14 sm:px-6 md:grid-cols-5 md:py-20">
		<div class="md:col-span-2">
			<div class="overflow-hidden rounded-lg shadow-sm" style="aspect-ratio: 4 / 5">
				<Image
					src={ericPhoto}
					alt="Eric Tulga, a counselor with a red beard and glasses, smiling in a sunlit room"
					width={800}
					height={1200}
					loading="eager"
					class="h-full w-full object-cover object-[50%_25%]"
				/>
			</div>
			<div class="mt-6 rounded-lg border border-stone-200 bg-white p-6 text-sm shadow-sm">
				<h2 class="text-lg">Credentials</h2>
				<ul class="mt-3 space-y-2">
					<li>MA, LPC — Licensed Professional Counselor</li>
					<li>Licensed by the State of Colorado, License LPC.0021647</li>
					<li>Years of practice in the Denver area, now fully online</li>
				</ul>
			</div>
		</div>
		<div class="md:col-span-3">
			<h2 class="text-3xl">Why I do this work</h2>
			<div class="prose-site mt-5 text-lg">
				<Bio />
			</div>

			{
				/*
				 The whole section is conditional because the list is Eric's to empty.
				 He cleared it in 09c482c and the page shipped an <h2> above an empty
				 <ul> — a dangling heading, and invalid HTML besides (<ul> requires at
				 least one <li>). Rendering nothing is correct whether he meant to drop
				 the section or intends to refill it.
				*/
			}
			{
				funList.length > 0 && (
					<>
						<h2 class="mt-12 text-3xl">What I like to do for fun</h2>
						<ul class="prose-site mt-5 list-disc space-y-2 pl-6 text-lg">
							{funList.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</>
				)
			}
		</div>
	</section>

	<CtaBand
		heading="Want to see if we're a good fit?"
		body="The first step is a free 15-minute phone call. No pressure, no commitment."
	/>
</Layout>
