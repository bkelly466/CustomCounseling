---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Paragraphs from '../components/Paragraphs.astro';
import FirstSteps from '../components/FirstSteps.astro';
import RelatedServices from '../components/RelatedServices.astro';
import { getEntry, render } from 'astro:content';

// Copy is CMS-editable (pages/mens-counseling); the H1, the section headings,
// and the layout stay code-owned.
//
// An item links when it names something that has a page of its own. The label
// is the anchor text, so the link describes its destination instead of saying
// "learn more". In the CMS the destination is a fixed dropdown, not free text.
const page = await getEntry('pages', 'mens-counseling');
const { Content: Intro } = await render(page);
const { workOnList = [] } = page.data;
---

<Layout>
	<PageHero heading="Online Counseling for Men in Colorado" subhead={page.data.heroSubhead} />

	<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 md:py-20">
		<div class="prose-site text-lg">
			<Intro />
		</div>

		{
			/*
			 Conditional for the reason /about's "fun" list is (fa530dd): a list Eric
			 empties in the CMS otherwise ships an <h2> above an empty <ul>, which is
			 a dangling heading and invalid HTML besides.
			*/
		}
		{
			workOnList.length > 0 && (
				<>
					<h2 class="mt-12 text-3xl">What we can work on</h2>
					<ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
						{workOnList.map((topic) => (
							<li class="flex items-center gap-3">
								<span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-clay-400" />
								{topic.link ? (
									<a href={topic.link} class="link-inline">
										{topic.text}
									</a>
								) : (
									topic.text
								)}
							</li>
						))}
					</ul>
				</>
			)
		}

		{
			page.data.closingBody && (
				<div class="prose-site mt-12 text-lg">
					<h2 class="text-3xl">No couch. No waiting room.</h2>
					<Paragraphs text={page.data.closingBody} />
				</div>
			)
		}
	</section>

	<RelatedServices />
	<FirstSteps />
</Layout>
