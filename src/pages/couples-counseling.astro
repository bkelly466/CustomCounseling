---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Paragraphs from '../components/Paragraphs.astro';
import FirstSteps from '../components/FirstSteps.astro';
import RelatedServices from '../components/RelatedServices.astro';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import couplesPhoto from '../assets/images/DenverMarriageCounseling.jpeg';

// Copy is CMS-editable (pages/couples-counseling); the H1, the section
// headings, the photo, and the link to /telehealth stay code-owned.
const page = await getEntry('pages', 'couples-counseling');
const { Content: Intro } = await render(page);
const { questions = [] } = page.data;
---

<Layout>
	<PageHero heading="Online Couples Counseling in Colorado" subhead={page.data.heroSubhead} />

	<section class="mx-auto max-w-3xl px-4 pt-14 sm:px-6 md:pt-20">
		<div class="prose-site text-lg">
			<Intro />
		</div>

		{
			/*
			 Conditional for the reason /about's "fun" list is (fa530dd): a list Eric
			 empties in the CMS otherwise ships an empty <ul>, which is invalid HTML.
			*/
		}
		{
			questions.length > 0 && (
				<ul class="mt-6 space-y-3">
					{questions.map((q) => (
						<li class="flex items-start gap-3">
							<span aria-hidden="true" class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-clay-400" />
							<span class="text-lg">{q}</span>
						</li>
					))}
				</ul>
			)
		}
	</section>

	<Image
		src={couplesPhoto}
		alt="A couple embracing outdoors at dusk, holding their baby between them"
		widths={[768, 1280, 1920, 2500]}
		sizes="100vw"
		class="mt-14 h-80 w-full object-cover object-[50%_25%] sm:h-88 md:mt-20 md:h-104 lg:h-124"
	/>

	<section class="mx-auto max-w-3xl px-4 pt-14 pb-14 sm:px-6 md:pt-20 md:pb-20">
		<div class="prose-site text-lg">
			{
				page.data.approachBody && (
					<>
						<h2 class="text-3xl">A focused 8–12 week approach</h2>
						<Paragraphs text={page.data.approachBody} />
					</>
				)
			}
			{
				page.data.videoBody && (
					<>
						<h2 class="text-3xl">How it works over video</h2>
						<Paragraphs text={page.data.videoBody} />
					</>
				)
			}
			<p><a href="/telehealth">See how online sessions work</a></p>
		</div>
	</section>

	<RelatedServices />
	<FirstSteps />
</Layout>
