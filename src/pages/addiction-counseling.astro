---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Paragraphs from '../components/Paragraphs.astro';
import FirstSteps from '../components/FirstSteps.astro';
import RelatedServices from '../components/RelatedServices.astro';
import { getEntry, render } from 'astro:content';

// D8: no "in Recovery" language anywhere on this page or its metadata.
//
// Copy is CMS-editable (pages/addiction-counseling); the H1, the section
// headings, and the layout stay code-owned. See src/content.config.ts.
const page = await getEntry('pages', 'addiction-counseling');
const { Content: Intro } = await render(page);
const { helpWithList = [], gainsList = [] } = page.data;
---

<Layout>
	<PageHero
		heading="Addiction & Substance Abuse Counseling, Online in Colorado"
		subhead={page.data.heroSubhead}
	/>

	<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 md:py-20">
		<div class="prose-site text-lg">
			<Intro />
		</div>

		{
			/*
			 Each list section is conditional for the reason /about's "fun" list is
			 (fa530dd): a list Eric empties in the CMS otherwise ships an <h2> above
			 an empty <ul>, which is a dangling heading and invalid HTML besides.
			*/
		}
		{
			helpWithList.length > 0 && (
				<>
					<h2 class="mt-12 text-3xl">What I help with</h2>
					<ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
						{helpWithList.map((item) => (
							<li class="flex items-center gap-3">
								<span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-clay-400" />
								{item}
							</li>
						))}
					</ul>
				</>
			)
		}

		{
			gainsList.length > 0 && (
				<>
					<h2 class="mt-12 text-3xl">What you get out of it</h2>
					<ul class="mt-6 space-y-3">
						{gainsList.map((item) => (
							<li class="flex items-start gap-3">
								<span aria-hidden="true" class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-clay-400" />
								<span class="text-lg">{item}</span>
							</li>
						))}
					</ul>
				</>
			)
		}

		<div class="prose-site mt-12 text-lg">
			<Paragraphs text={page.data.closingBody} />
		</div>
	</section>

	<RelatedServices />
	<FirstSteps />
</Layout>
