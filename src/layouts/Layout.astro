---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildHead } from '../lib/seo';

interface Props {
	/**
	 * Override the registered <title>. Pages should not normally pass this —
	 * titles live in the registry in src/lib/seo.ts so the whole set can be
	 * audited for length and duplication in one file.
	 */
	title?: string;
	/** Override the registered meta description. Same caveat as `title`. */
	description?: string;
}

// The layout looks its own metadata up from the URL rather than taking it as
// props. That is the point of the module: a page cannot ship with a missing,
// duplicated, or stale description, because it never states one.
const { title, description, canonical, ogImage, jsonLd } = await buildHead(
	Astro.url,
	Astro.site,
	Astro.props,
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" href="/favicon-512.png" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!--
			Open Graph / Twitter. The card at og:image is generated, not designed —
			`node scripts/build-og-image.mjs` renders it from the home-page hero.
			Swap the file at that path when a designed card is approved; nothing
			here changes.
		-->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Custom Counseling LLC" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Custom Counseling — Eric Tulga, MA, LPC. Online counseling across Colorado."
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
	</head>
	<body class="flex min-h-screen flex-col">
		<a href="#main" class="skip-link">Skip to main content</a>
		<Header />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
